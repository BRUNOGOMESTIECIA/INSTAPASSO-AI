rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se é admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Regra para coleção de Domínios
    match /domains/{domainId} {
      allow read: if true; // Apenas Cloud Functions / App Check
      allow write, update, delete: if isAdmin();
    }

    // Regra para Logs de Auditoria (Apenas leitura por Admin, escrita server-side)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Apenas Cloud Functions em background
    }

    // Regra para Solicitações de Validação
    match /validation_requests/{requestId} {
      allow read, write: if false; // Totalmente isolado no backend
    }
  }
}
