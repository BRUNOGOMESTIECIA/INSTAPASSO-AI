rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se é admin da TI ecia
    function isTieciaAdmin() {
      return request.auth != null && request.auth.token.email.matches('.*@tiecia\\.com\\.br');
    }

    // Regra para coleção de Domínios
    match /domains/{domainId} {
      // Qualquer usuário logado pode ler (necessário para a trava do Zero-Trust na hora do login)
      allow read: if request.auth != null; 
      // Apenas administradores oficiais (seu domínio) podem cadastrar, editar ou deletar clientes
      allow write, update, delete: if isTieciaAdmin();
    }

    // Regra para coleção da Equipe Interna (Operadores)
    match /operators/{operatorId} {
      // Qualquer usuário logado pode ler para validar se tem acesso
      allow read: if request.auth != null; 
      // Apenas administradores do InstaPasso podem gerenciar a equipe
      allow write, update, delete: if isTieciaAdmin();
    }

    // Regra para Logs de Auditoria (Apenas leitura por Admin, escrita server-side)
    match /audit_logs/{logId} {
      allow read: if isTieciaAdmin();
      allow write: if false; // Apenas Cloud Functions em background
    }

    // Regra para Solicitações de Validação
    match /validation_requests/{requestId} {
      allow read, write: if false; // Totalmente isolado no backend
    }
  }
}
